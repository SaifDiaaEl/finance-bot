{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["public/**", "src/**", "node_modules/**"]
      }
    }
  ],
  "rewrites": [
    { "source": "/api/webhook", "destination": "/api/index.js" },
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/(.*\\.html)", "destination": "/$1" },
    { "source": "/(.*)", "destination": "/api/index.js" }
  ]
}
